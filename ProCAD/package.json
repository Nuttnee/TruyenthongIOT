{
  "name": "procad",
  "version": "0.1.0",
  "description": "KiCad-compatible circuit + microcontroller simulator, driven from the command line",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "procad": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "procad": "tsx src/cli/index.ts",
    "fixtures": "node scripts/build-fixtures.mjs",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "avr8js": "0.21.1",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
